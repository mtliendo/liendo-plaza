# Local Postgres, or Neon pooled URL in production.
DATABASE_URL=postgres://ubuntu:ubuntu@127.0.0.1:5432/liendo_plaza

# Server-only signing secret for short-lived family tokens after QR pairing.
# Never type this, never send it in chat, never show it on a screen.
# Generate with: openssl rand -hex 32
FAMILY_ACCESS_SECRET=

# Optional. Private iCloud public-share URL (webcal:// or https://).
# Read only on the server. Never sent to a browser or the phone.
# Leave empty to use the synthetic sample calendar.
FAMILY_ICAL_URL=

# Vercel Blob read/write token. Leave empty for local disk storage
# under apps/web/data/uploads (gitignored).
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/reminders. Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Allow ?fixture=events-0|events-3|events-12 on snapshot/display in production-like deploys.
# Local next dev already allows fixtures. Never enable this in the live house.
NEXT_PUBLIC_ALLOW_EVENT_FIXTURES=

# Public origin of the Next.js app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phone app API origin. On device use your machine LAN URL or the Vercel URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
